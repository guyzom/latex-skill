heading_suffix "}\n"
delim_0 " \\LakitIndexLocators{\\en{"
delim_1 " \\LakitIndexLocators{\\en{"
delim_2 " \\LakitIndexLocators{\\en{"
delim_t "}}\\LakitIndexEnd\\end{otherlanguage}"
